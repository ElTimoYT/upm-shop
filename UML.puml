package "data.repository" {
  interface Repository<T, K> {

      + create(element : T) : T
      + get(id : K) : T
      + getAll() : List<T>
      + update(element : T) : T
      + remove(id : K) : T
      + existsId(id : K) : boolean
      + getSize() : int
  }

abstract class AbstractRepository<T, K> implements Repository<T, K> {

    # cache : Map<K, T>
    # GSON : Gson

    # getFilePath() : String
    # getId(element : T) : K
    # getTypeToken() : TypeToken<List<T>>
    # getFile() : File
    # loadCacheIfNeeded() : void
    # persist() : void

    + create(element : T) : T
    + update(element : T) : T
    + get(id : K) : T
    + remove(id : K) : T
    + getAll() : List<T>
    + existsId(id : K) : boolean
    + getSize() : int
}


  class ProductRepository extends AbstractRepository<Product, String> {

      - autoincrementId : int

      + getAutoincrementId() : int
      + nextAutoincrementId() : int

      # getFilePath() : String
      # getId(product : Product) : String
      # getTypeToken() : TypeToken<List<Product>>
      # loadCacheIfNeeded() : void
      # persist() : void
  }

  class TicketRepository extends AbstractRepository<Ticket, Integer> {

      # getFilePath() : String
      # getId(ticket : Ticket) : Integer
      # getTypeToken() : TypeToken<List<Ticket>>
  }

  class CashierRepository extends AbstractRepository<Cashier, String> {

      # getFilePath() : String
      # getId(cashier : Cashier) : String
      # getTypeToken() : TypeToken<List<Cashier>>
  }

  class ClientRepository extends AbstractRepository<Client, String> {

      # getFilePath() : String
      # getId(client : Client) : String
      # getTypeToken() : TypeToken<List<Client>>
  }

}

package "data.repository.adapters" {
  class LocalDateTimeAdapter {
    +serialize(LocalDateTime, Type, JsonSerializationContext): JsonElement
