package "commands" {
  class CommandDispatcher {

      - ERROR_NO_COMMAND_FOUND : String
      - ERROR_UNKNOWN_COMMAND : String
      - ERROR_UNEXPECTED_EXCEPTION : String

      - noCommandFoundMessage : String
      - unknownCommandMessage : String

      + CommandDispatcher()
      + CommandDispatcher(noCommandFoundMessage : String, unknownCommandMessage : String)

      + addCommand(name : String, commandHandler : CommandHandler) : void
      + processCommand(command : String) : void
      + processCommand(tokens : CommandTokens) : void

      - tokenizeCommand(command : String) : CommandTokens
  }

  class CommandTokens {

      - tokens : Iterator<String>
      - currentToken : String
      - remainingTokens : int

      + CommandTokens(tokens : List<String>)

      - consumeToken() : void
      - checkToken() : void

      + getRemainingTokens() : int
      + next() : String
      + hasNext() : boolean

      - tryParseInt() : OptionalInt
      + nextInt() : int
      + hasNextInt() : boolean

      - tryParseDouble() : OptionalDouble
      + nextDouble() : double
      + hasNextDouble() : boolean

      - tryParseProductCategory() : Optional<ProductCategoryDTO>
      + nextProductCategory() : ProductCategoryDTO
      + hasNextProductCategory() : boolean

      - tryParseServiceCategory() : Optional<ServiceCategoryDTO>
      + nextServiceCategory() : ServiceCategoryDTO
      + hasNextServiceCategory() : boolean

      - tryParseDate() : Optional<LocalDate>
      + nextDate() : LocalDateTime
      + hasNextDate() : boolean
  }
}

package "commands.handlers" {
  interface CommandHandler {
    +runCommand(CommandTokens)
  }

  class EchoCommandHandler {

      - ERROR_INCORRECT_USE : String
      - ECHO_MESSAGE : String

      + runCommand(tokens : CommandTokens) : void
  }

  class HelpCommandHandler {

      - HELP_MESSAGE : String
      - DISCOUNT_MESSAGE : String

      + runCommand(tokens : CommandTokens) : void
  }

  class ExitCommandHandler {
    +runCommand(CommandTokens)
  }

